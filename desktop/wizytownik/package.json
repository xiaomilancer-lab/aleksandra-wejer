{
  "name": "wizytownik-psycholki-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Bezpieczna aplikacja Windows do Wizytownika psychOLKI",
  "main": "main.cjs",
  "scripts": {
    "pack": "electron-builder --win dir",
    "dist": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "44.2.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "pl.aleksandrawejer.wizytownik",
    "productName": "Wizytownik psychOLKI",
    "artifactName": "Wizytownik-psychOLKI-${version}-Windows.${ext}",
    "asar": true,
    "compression": "maximum",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main.cjs",
      "package.json"
    ],
    "win": {
      "target": "portable",
      "icon": "build/icon.png"
    }
  }
}
